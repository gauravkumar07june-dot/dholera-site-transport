rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Replace PASTE_ADMIN_EMAIL with the admin's sign-in email (same as in firebase-config.js).
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['paste_admin_email'];
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /trips/{id} {
      allow read: if signedIn();

      // Staff can only create a request that waits for the admin.
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.status == 'approval'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.size() <= 40);

      // Admin approves, assigns, rejects. Staff may cancel their own request.
      // Drivers may only mark picked up / dropped.
      allow update: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid
            && resource.data.status in ['approval', 'assigned']
            && request.resource.data.status == 'cancelled'
            && changed().hasOnly(['status', 'cancelledAt']))
        || (signedIn() && resource.data.status in ['assigned', 'picked']
            && request.resource.data.status in ['picked', 'done']
            && changed().hasOnly(['status', 'pickedAt', 'doneAt']));

      allow delete: if isAdmin();
    }

    match /vehicles/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Drivers may change only their status and location.
      allow update: if isAdmin() || (signedIn() && changed().hasOnly(['status', 'at']));
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
