rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin sign-in email (same as in firebase-config.js), lowercase.
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['gaurav.kumar21@lntecc.com'];
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /trips/{id} {
      allow read: if signedIn();

      // Staff create a request that waits for the IS or the admin.
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.status in ['approval', 'is_pending']
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.size() <= 50);

      allow update: if isAdmin()
        // Staff cancel their own request before pickup.
        || (signedIn() && resource.data.createdBy == request.auth.uid
            && resource.data.status in ['is_pending', 'approval', 'assigned']
            && request.resource.data.status == 'cancelled'
            && changed().hasOnly(['status', 'cancelledAt']))
        // Immediate supervisor approves or rejects a long-distance request.
        || (signedIn() && resource.data.status == 'is_pending'
            && request.resource.data.status in ['approval', 'rejected']
            && changed().hasOnly(['status', 'isApprovedAt', 'isRejectedAt', 'rejectedAt', 'isDecisionBy', 'isNote']))
        // Driver and staff move the ride forward, with speedometer readings.
        || (signedIn() && resource.data.status in ['assigned', 'arrived', 'picked']
            && request.resource.data.status in ['arrived', 'picked', 'done']
            && changed().hasOnly(['status', 'arrivedAt', 'pickedAt', 'doneAt', 'confirmedAt', 'odoStart', 'odoEnd', 'km']))
        // Speedometer readings shared with the other passengers of the same vehicle.
        || (signedIn() && resource.data.status in ['assigned', 'arrived', 'picked', 'done']
            && changed().hasOnly(['odoStart', 'odoEnd', 'km']))
        // Staff confirm they reached, or report a problem, after the drop.
        || (signedIn() && resource.data.status == 'done'
            && changed().hasOnly(['confirmedAt', 'issue', 'issueAt']));

      allow delete: if isAdmin();
    }

    // Staff & IS directory (phones and IS numbers): anyone signed in can look up one PS no.; only the admin can list or edit.
    match /staff/{id} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Name list for the booking dropdown: name, PS no., cadre, department, IS name. No phone numbers.
    match /directory/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vehicles/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Drivers may change only their status and location.
      allow update: if isAdmin() || (signedIn() && changed().hasOnly(['status', 'at']));
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
